# ESP32-S3-RLCD-4.2 步步高模拟器配置
# 芯片: ESP32-S3-WROOM-1-N16R8 (16MB Flash, 8MB PSRAM)

CONFIG_IDF_TARGET="esp32s3"

# Flash
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# 分区表 (自定义,容纳大应用)
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM (8MB 八线, 80MHz) — gam4980 的 6MB ROM 数据必须放 PSRAM
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
# 允许 BSS 段放 PSRAM (sys 结构体 ~6MB)
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# V1.0.64: 关闭 SPIRAM_RODATA (字库等 rodata 保持 Flash XIP, 不进 PSRAM).
# 之前=y 时开机把全部字库(~4.9MB)复制进 PSRAM, 堆只剩 3.1MB,
# gam4980 需要 6MB PSRAM -> 分配失败 -> 进游戏 5% 时写空指针崩溃重启.
# 现在字库按需从 Flash 缓存读取, PSRAM 堆恢复到 ~7.4MB, BBK 正常.
# CONFIG_SPIRAM_RODATA=y
# 非必要数据尽量放 PSRAM: ALWAYSINTERNAL 阈值调小 (≤此值才保留内部), 内部预留调小
# 以腾出 ≥32KB 连续内部块给 BBK 引擎 sys_ram (动态分配).
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=2048
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=24576
# 允许 FreeRTOS 任务栈放 PSRAM (音频解码任务栈 60KB, 蓝牙任务栈也需要)
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# FAT 文件系统 (SD 卡读 ROM, 支持中文长文件名)
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_CODEPAGE=936
CONFIG_FATFS_API_ENCODING_UTF_8=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# === 方案A V1.x: Bluepad32 内核 (BTstack 替换 Bluedroid) ===
# ESP32-S3 仅支持 BLE (无 BR/EDR). BTstack 以 LE-only 控制器 + vHCI Host 工作.
# 控制器单独启用 (CONFIG_BT_CONTROLLER_ONLY=y), Host 层由 BTstack 提供, 不再用 Bluedroid/esp_hidh.
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ONLY=y
CONFIG_BT_BLUEDROID_ENABLED=n
# 控制器 BLE 配置 (S3 单模): 活动连接只需 2 条 (单手柄, 冗余一条), 省内部 RAM
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_ACL_CONNECTIONS=2
# 广播/扫描去重过滤缓存降低 (内部 RAM)
CONFIG_BT_CTRL_ADV_DUP_FILT_MAX=10

# --- BTstack ---
CONFIG_BTSTACK_INTERNAL_BT=y    # 用 SoC 蓝牙 (vHCI Host)
CONFIG_BTSTACK_AUDIO=n          # 音频驱动不走 btstack, 节省空间
CONFIG_BTSTACK_HCI_DUMP_STDOUT=n

# --- Bluepad32 ---
CONFIG_BLUEPAD32_MAX_DEVICES=1
CONFIG_BLUEPAD32_PLATFORM_CUSTOM=y
CONFIG_BLUEPAD32_USB_CONSOLE_ENABLE=n
CONFIG_BLUEPAD32_GAP_SECURITY=y
CONFIG_BLUEPAD32_LOG_LEVEL_ERROR=y

# 禁用 secure boot (避免依赖 micro-ecc submodule)
CONFIG_SECURE_BOOT=n
CONFIG_SECURE_BOOT_V2_ENABLED=n

# lwip 已从 gitee 镜像克隆, 启用网络栈 (esp_http_server 等组件依赖)
# CONFIG_LWIP_ENABLE 默认为 y (SOC_WIFI_SUPPORTED)

# 启用 mbedTLS 证书包 (V1.0.68 天气时钟 HTTPS 需要 esp_crt_bundle)
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# 关闭 mbedTLS 硬件加速 (上游 mbedtls 不含 espressif 的 soft fallback 类型)
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_HARDWARE_MPI=n
CONFIG_MBEDTLS_HARDWARE_SHA=n
CONFIG_MBEDTLS_HARDWARE_GCM=n
CONFIG_MBEDTLS_HARDWARE_ECC=n
CONFIG_MBEDTLS_HARDWARE_ECDSA_SIGN=n
CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY=n
CONFIG_MBEDTLS_GCM_SUPPORT_NON_AES_CIPHER=n
CONFIG_TINYUSB_MSC_ENABLED=y
# USB HID 复合设备: 2 个 HID 接口 (键盘 + 鼠标)
CONFIG_TINYUSB_HID_COUNT=2

# CPU 频率: 240MHz (默认 160MHz, 提升 50% 性能)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240

# 编译器优化: 速度优先 (-O2 替代默认 -Os)
CONFIG_COMPILER_OPTIMIZATION_SPEED=y

# WiFi 联网 (V1.0.46 起启用: STA 连接, 设置中心扫描并输入密码)
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_COEX_ENABLED=y
# V1.0.67: 蓝牙+音频占用大量 DMA 后, WiFi 16KB 静态 RX 缓冲分不到导致 init 失败,
# 减小缓冲降低 DMA 需求 (网页手柄/天气小数据足够)
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# main 任务栈: 默认 3584 对引擎启动/加载链(在 main 任务上运行)太浅,
# 打开任意引擎会触发 "stack overflow in task main" 重启。
# 调到 12288, 为 NES/GB/Arduboy start 与 gam4980 libretro 初始化链提供充足栈。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# === V1.0.9x: 精简 WiFi 内存 ===
# WiFi 目前只两个用途: ①STA 联网(天气/同步) ②softAP 开热点当网页手柄.
# 都是小数据量, 默认 16 动态收发缓冲/32 管理短缓冲对我们是浪费,
# 下发后可腾出数千字节内部 DMA, 避免 WiFi 手柄启动时与蓝牙争 DMA 失败.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
# IEEE802.11 接收去重共缓存降到 256 (小热点场景够用, 省 DMA)
CONFIG_ESP32_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=6
